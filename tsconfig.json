{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@core/*": ["./core/*"],
      "@window-manager/*": ["./window-manager/*"],
      "@programs/*": ["./programs/*"],
      "@components/*": ["./components/*"],
      "@file-system/*": ["./file-system/*"],
      "@wallpapers/*": ["./wallpapers/*"],
      "virtual:programs": ["./virtual-programs.d.ts"],
      "virtual:images": ["./virtual-images.d.ts"],
      "virtual:videos": ["./virtual-videos.d.ts"],
      "virtual:music": ["./virtual-music.d.ts"]
    }
  },
  "include": [
    "src",
    "core",
    "window-manager",
    "programs",
    "context-menu",
    "file-system",
    "wallpapers",
    "components",
    "cli",
    "vite-plugin-programs.ts",
    "vite-plugin-images.ts",
    "vite-plugin-videos.ts",
    "vite-plugin-music.ts",
    "vite.config.ts",
    "virtual-programs.d.ts",
    "virtual-images.d.ts",
    "virtual-videos.d.ts",
    "virtual-music.d.ts",
    "vite-env.d.ts"
  ]
}
